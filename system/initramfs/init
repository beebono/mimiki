#!/bin/sh
# Minimal GAMES parition detect/create and switch_root

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# RG Rotate: SD card is mmc0 (ums512.dtsi: mmc0 = &sdio0; eMMC is mmc3)
# Layout: p1 uboot (raw DHTB), p2 boot FAT, p3 rootfs squashfs, p4 games
DEVICE="/dev/mmcblk0"
ROOT_DEVICE="${DEVICE}p3"
PART_DEVICE="${DEVICE}p4"

switch_to_mimiki() {
    mount "$ROOT_DEVICE" /newroot
    if [ $? -ne 0 ]; then
        poweroff -f # So it doesn't fallback to emmc and possibly mess with the sdcard
    fi

    mount --move /dev /newroot/dev
    mount --move /dev/shm /newroot/dev/shm
    mount --move /dev/pts /newroot/dev/pts
    mount --move /mnt/games /newroot/mnt/games
    mount --move /proc /newroot/proc
    mount --move /run /newroot/run
    mount --move /sys /newroot/sys
    mount --move /tmp /newroot/tmp

    exec switch_root -c /dev/tty0 /newroot /sbin/init
}

mkdir -p /dev /mnt/games /newroot /tmp
mount -t proc proc /proc
mount -t tmpfs none /run
mount -t sysfs sysfs /sys
mount -t tmpfs -o size=64m,mode=1777 tmpfs /tmp
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/shm
mount -t tmpfs -o size=128m,mode=1777 tmpfs /dev/shm
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

[ -e /dev/null ] || mknod -m 666 /dev/null c 1 3
[ -e /dev/zero ] || mknod -m 666 /dev/zero c 1 5
[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1

DEV_CHECKS=0
while [ ! -b "$DEVICE" ]; do
    DEV_CHECKS=$((DEV_CHECKS + 1))
    if [ $DEV_CHECKS -ge 50 ]; then
        # $DEVICE didn't appear after 5 seconds, attempt anyway
        switch_to_mimiki
    fi
    sleep 0.1
done

if blkid -s TYPE -o value "$PART_DEVICE" 2>/dev/null | grep -q .; then
    # Main GAMES partition already set up, let's go!
    mount "$PART_DEVICE" /mnt/games
    switch_to_mimiki
fi

# Extend table
sgdisk -e "$DEVICE"
# Create maximum new partition 5
sgdisk -N 4 "$DEVICE"

# Let the device settle
sleep 0.2
partprobe "$DEVICE"

PART_CHECKS=0
while [ ! -b "$PART_DEVICE" ]; do
    PART_CHECKS=$((PART_CHECKS + 1))
    if [ $PART_CHECKS -eq 100 ]; then
        # $PART_DEVICE didn't appear after 10 seconds, attempt anyway
        switch_to_mimiki
    fi
    sleep 0.1
done

mkfs.exfat -n GAMES "$PART_DEVICE"
if [ $? -ne 0 ]; then
    # Failed to format partition, attempt anyway
    switch_to_mimiki
fi

mkdir -p /mnt/games
mount "$PART_DEVICE" /mnt/games
if [ $? -eq 0 ]; then
    mkdir -p /mnt/games/data/ppsspp/PSP/SYSTEM
    mkdir -p /mnt/games/data/saves
    mkdir -p /mnt/games/data/states
    mkdir -p /mnt/games/data/.cache
    mkdir -p /mnt/games/n64
    mkdir -p /mnt/games/stn
    mkdir -p /mnt/games/dc
    mkdir -p /mnt/games/ps1
    mkdir -p /mnt/games/psp

    cat > /mnt/games/README.txt <<EOF
MIMIKI - Game Storage

Place your game ROMs in the appropriate directories:

  /n64   - .z64, .n64, .v64
  /stn   - .chd, .iso, .bin/.cue  ! BIOS FILES REQUIRED UNDER /data
  /dc    - .chd, .gdi, .cdi       ! BIOS FILES REQUIRED UNDER /data
  /ps1   - .chd, .pbp, .bin/.cue  ! BIOS FILES REQUIRED UNDER /data
  /psp   - .chd, .cso, .iso

You can also make these same base folders on a second SD card
formatted as either fat32 or exfat and place your games in there!
The launcher will automatically scan these directories on boot.

For more information: https://github.com/beebono/mimiki
EOF

    sync
fi

switch_to_mimiki
