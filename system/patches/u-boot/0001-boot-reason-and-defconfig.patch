diff --git a/arch/arm/mach-rockchip/rk3568/rk3568.c b/arch/arm/mach-rockchip/rk3568/rk3568.c
index c2b96902d2d..b8730b2ee22 100644
--- a/arch/arm/mach-rockchip/rk3568/rk3568.c
+++ b/arch/arm/mach-rockchip/rk3568/rk3568.c
@@ -6,7 +6,10 @@
 #define LOG_CATEGORY LOGC_ARCH
 
 #include <dm.h>
+#include <env.h>
 #include <misc.h>
+#include <power/pmic.h>
+#include <power/rk8xx_pmic.h>
 #include <asm/armv8/mmu.h>
 #include <asm/arch-rockchip/bootrom.h>
 #include <asm/arch-rockchip/grf_rk3568.h>
@@ -200,3 +203,28 @@ int checkboard(void)
 
 	return 0;
 }
+
+int rk_board_late_init(void)
+{
+	struct udevice *dev;
+	int on_source;
+	int ret;
+
+	ret = uclass_first_device_err(UCLASS_PMIC, &dev);
+	if (ret)
+		return 0;
+
+	if (device_is_compatible(dev, "rockchip,rk817") ||
+	    device_is_compatible(dev, "rockchip,rk809"))
+		on_source = pmic_reg_read(dev, RK817_ON_SOURCE);
+	else
+		on_source = pmic_reg_read(dev, RK8XX_ON_SOURCE);
+
+	if (on_source < 0)
+		return 0;
+
+	if (on_source & RK8XX_ON_PLUG_IN)
+		env_set("boot_reason", "boot_reason=charger");
+
+	return 0;
+}
