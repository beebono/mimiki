# MIROKI - Busybox inittab
# /etc/inittab: init(8) configuration for busybox

# Bring it up
::sysinit:/etc/init.d/rcS

# Keep launcher alive. tty0 is the panel; only the launcher draws there -
# the system console lives on serial so boot/shutdown chatter stays off screen
tty0::respawn:/bin/sh -l -c "/usr/bin/mimiki-launcher"

# USB gadget serial console (CDC-ACM via built-in g_serial) for debugging.
# -n -l: skip the login prompt and drop straight into a shell (no accounts)
::respawn:/sbin/getty -n -l /bin/sh -L 115200 ttyGS0 vt100

# Break it down
::shutdown:/etc/init.d/rcK
